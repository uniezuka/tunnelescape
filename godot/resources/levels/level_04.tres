[gd_resource type="Resource" script_class="LevelData" load_steps=9 format=3]

[ext_resource type="Script" path="res://scripts/data/level_data.gd" id="1"]
[ext_resource type="Script" path="res://scripts/data/room_data.gd" id="2"]
[ext_resource type="PackedScene" path="res://scenes/rooms/room_04_start.tscn" id="3"]
[ext_resource type="PackedScene" path="res://scenes/rooms/room_04_wrong.tscn" id="4"]
[ext_resource type="PackedScene" path="res://scenes/rooms/room_04_exit.tscn" id="5"]

[sub_resource type="Resource" id="Resource_start"]
script = ExtResource("2")
room_id = "start"
room_name = "Start Room"
scene = ExtResource("3")
revisit_caption = "Tap the other tunnel to find the exit."

[sub_resource type="Resource" id="Resource_wrong"]
script = ExtResource("2")
room_id = "wrong"
