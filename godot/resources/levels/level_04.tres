[sub_resource type="Resource" id="Resource_exit"]
script = ExtResource("2")
room_id = "exit"
room_name = "Exit Room"
scene = ExtResource("5")

[resource]
script = ExtResource("1")
level_id = "level_04"
level_number = 4
move_limit = -1
starting_room_id = "start"
starting_power_ups = {"warp_scroll": 1}
rooms = Array[Resource]([SubResource("Resource_start"), SubResource("Resource_wrong"), SubResource("Resource_exit")])
